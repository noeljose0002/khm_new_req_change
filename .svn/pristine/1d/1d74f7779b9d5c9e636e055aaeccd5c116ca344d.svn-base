<?php

namespace App\Models;

use CodeIgniter\Model;

class MonthlyTargetReportModel extends Model
{
    protected $table = 'khm_obj_enquiry_header';
    protected $primaryKey = 'enquiry_header_id';

    public function getByDateRange($fromYmd, $toYmd, $executive_id, $target_id, $system)
    {
      
        $q1 = $this->db->table('khm_obj_enquiry_header h')
            ->select([
                'e.entity_id',
                'e.entity_name',
                'mt.target_id',
                'mt.target_name',
                'mt.target_from_date',
                'mt.target_to_date',
                'ta.target_amount',
                'COALESCE(SUM(de.tpc),0) AS total_tpc'
            ])
            ->join('khm_entity_mst e', 'e.entity_id = h.employee_entity_id', 'inner')
            ->join('khm_entity_mst_target_assign ta', 'ta.entity_id = e.entity_id', 'left')
            ->join('khm_obj_mst_target mt', 'mt.target_id = ta.target_id', 'left')
            ->join('khm_obj_enquiry_detail_extensions de', 'de.enquiry_header_id = h.enquiry_header_id', 'left')
            ->where('h.is_active', 1)
            ->where('de.is_active', 1)
            ->where('ta.deleted', 0)
            ->where('mt.deleted', 0)
            ->where('mt.target_status', 1)
            ->where('h.enq_added_date >=', $fromYmd)
            ->where('h.enq_added_date <=', $toYmd)
            ->groupBy(['e.entity_id', 'mt.target_id']);

        
        $q2 = $this->db->table('khm_obj_enquiry_header h')
            ->select([
                'tl.entity_id',
                'tl.entity_name',
                'mt.target_id',
                'mt.target_name',
                'mt.target_from_date',
                'mt.target_to_date',
                'ta.target_amount',
                'COALESCE(SUM(de.tpc),0) AS total_tpc'
            ])
            ->join('khm_obj_enquiry_details d', 'd.enquiry_header_id = h.enquiry_header_id', 'inner')
            ->join('khm_entity_mst tl', 'tl.entity_id = d.sales_support_assigned_to', 'inner')
            ->join('khm_entity_mst_target_assign ta', 'ta.entity_id = tl.entity_id', 'left')
            ->join('khm_obj_mst_target mt', 'mt.target_id = ta.target_id', 'left')
            ->join('khm_obj_enquiry_detail_extensions de', 'de.enquiry_header_id = h.enquiry_header_id', 'left')
            ->where('h.is_active', 1)
            ->where('de.is_active', 1)
            ->where('ta.deleted', 0)
            ->where('mt.deleted', 0)
            ->where('mt.target_status', 1)
            ->where('h.enq_added_date >=', $fromYmd)
            ->where('h.enq_added_date <=', $toYmd)
            ->groupBy(['tl.entity_id', 'mt.target_id']);

        
        if ($executive_id !== 'all') {
            $q1->where('e.entity_id', $executive_id);
            $q2->where('tl.entity_id', $executive_id);
        }

        if ($target_id !== 'all') {
            $q1->where('mt.target_id', $target_id);
            $q2->where('mt.target_id', $target_id);
        }

        if ($system) {
            $q1->where('h.enq_type_id', $system);
            $q2->where('h.enq_type_id', $system);
        }

        /* ===== UNION ===== */
        $sql = '(' . $q1->getCompiledSelect() . ')
                UNION ALL
                (' . $q2->getCompiledSelect() . ')
                ORDER BY entity_name';

        return $this->db->query($sql)->getResultArray();
    }
}
