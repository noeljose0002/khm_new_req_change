						</tr>
						<tr >
							 <td style="background-color:#D3D3D3 ;"><b>Total Package Cost</b></td>
							 <td style="text-align:right;background-color:#D3D3D3 ;"><?php echo $iti_cost_datas[0]['tpc']; ?></td>
